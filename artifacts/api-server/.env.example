# === DATABASE ===
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/smm_panel

# === JWT & AUTH ===
# Generate 64-char secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_secret_here

# === SERVER ===
# Port for API server
PORT=3000
# One of: development, production
NODE_ENV=development

# === FRONTEND ===
# Frontend URL (for CORS)
SITE_URL=http://localhost:5173

# === FILE UPLOAD ===
# Max file size in bytes
MAX_FILE_SIZE=52428800
# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf

# === RATE LIMITING ===
# Per-minute requests per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# === PAYMENT PROVIDERS ===

# SePay Webhook (for bank transfers)
SEPAY_WEBHOOK_SECRET=

# ThueAPIBank (card payments)
THUEAPIBANK_ACCOUNT_ID=
THUEAPIBANK_API_KEY=
THUEAPIBANK_WEBHOOK_SECRET=

# GachTheFast (card transfers)
GACHTHEFAST_PARTNER_ID=
GACHTHEFAST_PARTNER_KEY=

# === NOTIFICATIONS ===

# Telegram Bot for notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SMM Pro

# === SECURITY ===

# Turnstile (Cloudflare CAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === CRON JOBS ===
# Secret key for triggering cron endpoints
CRON_SECRET=your_cron_secret_here

# === LOGGING (optional) ===
LOG_LEVEL=info
