# ═══════════════════════════════════════════════════════════════════════════════
# SMM PANEL PRO — PHP MVC Environment Configuration
# Copy this file to .env and fill in your values
# Place .env in: public_html/ OR one level above (more secure: ~/username/.env)
# ═══════════════════════════════════════════════════════════════════════════════

APP_ENV=production
APP_DEBUG=false

# ── Database (MySQL/MariaDB) — BẮT BUỘC ──────────────────────────────────────
# Option A: Full URL
# DATABASE_URL=mysql://user:password@localhost:3306/smm_panel

# Option B: Individual values
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smm_panel
DB_USER=your_db_user
DB_PASS=your_db_password

# ── Security — BẮT BUỘC ──────────────────────────────────────────────────────
# JWT secret — minimum 64 random characters
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING_abc123xyz789

# Secret salt for legacy password migration (SHA-256 → bcrypt)
SECRET_SALT=smm-panel-salt-2024

# Setup key for creating first admin account
SETUP_KEY=

# Cron secret — for /api/cron/* endpoints
CRON_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=https://vietool.cc

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SePay Bank Webhook ────────────────────────────────────────────────────────
SEPAY_WEBHOOK_SECRET=

# ── Thẻ Cào (thesieure.com) ───────────────────────────────────────────────────
CARD_PARTNER_ID=
CARD_PARTNER_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
