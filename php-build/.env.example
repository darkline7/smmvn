# ═══════════════════════════════════════════════════════
# SMM PANEL PRO — CẤU HÌNH PHP
# Đặt file này thành .env ở THƯ MỤC PUBLIC_HTML
# Ví dụ: /home/username/public_html/.env
# HOẶC ở thư mục cha: /home/username/.env
# ═══════════════════════════════════════════════════════

# Database PostgreSQL — từ Neon.tech (BẮT BUỘC)
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require

# JWT Secret — dùng để ký session cookie (BẮT BUỘC, ít nhất 32 ký tự)
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_128_KY_TU

# URL website của bạn (không có dấu / cuối)
SITE_URL=https://vietool.cc

# Salt cho mật khẩu cũ (legacy SHA-256)
SECRET_SALT=smm-panel-salt-2024

# SePay webhook secret
SEPAY_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Khoá dùng 1 lần để tạo admin đầu tiên
# POST /api/auth/make-admin {"email":"...","setupKey":"..."}
SETUP_KEY=
